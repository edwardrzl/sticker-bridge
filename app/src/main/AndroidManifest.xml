<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Needed to check whether WhatsApp is installed and whether a pack is added (ADR-006). -->
    <queries>
        <package android:name="com.whatsapp" />
    </queries>

    <application
        android:name=".StickerBridgeApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only WhatsApp can read the packs (NFR8). -->
        <provider
            android:name=".pack.whatsapp.StickerContentProvider"
            android:authorities="com.edrl.stickerbridge.stickercontentprovider"
            android:enabled="true"
            android:exported="true"
            android:readPermission="com.whatsapp.sticker.READ" />
    </application>
</manifest>
